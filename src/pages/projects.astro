---
import Menu from '../components/Menu.svelte';
import Layout from '../layouts/Layout.astro';
const projects = [
    {
        title: "Dayelis",
        summary: "Personal Discord Bot for my group's TTRPG activities hosted on my Raspberry Pi",
        purpose: "To learn the process of making a Discord bot, while developing useful features for a TTRPG group like pulling information from Archives of Nethys.",
        stack: ["Python", "discord.py", "Raspberry Pi", "JSON"],
        status: "Live",
        github: "https://github.com/ThatOneSongbird/Dayelis",
        site: null,
        icon: "images/dayelis.png",
    },
    {
        title: "Portfolio V1",
        summary: "My first attempt at a Portfolio using Python and Flask, hosted on the Pi through a Cloudflare Tunnel",
        purpose: "To teach the basics of webdev and to have a place to showoff my projects",
        stack: ["Python", "Flask", "Jinja2", "HTML/CSS"],
        status: "Archived",
        github: "https://github.com/ThatOneSongbird/Portfolio-Website",
        site: null,
        icon: null,
    },
    {
        title: "Portfolio V2",
        summary: "My second attempt at a Portfolio, this time with Javascript and supporting frameworks, hosted on the Pi through a Cloudflare Tunnel.",
        purpose: "To make a nice, aesthetic, and impressive portofolio to showcase my creativity and abilities.",
        stack: ["JavaScript", "Astro", "Svelte", "Three.js"],
        status: "Live",
        github: "https://github.com/ThatOneSongbird/Portfolio-V2",
        site: "https://thatoneportfolio.dev",
        icon: null,
    }
];
---

<Layout title="Projects">
    <main>
        <h1>Projects</h1>

        {projects.map((project) => (
            <article>
                <h2>
                    {project.site
                    ? <a href={project.site}>{project.title}</a>
                    : project.title}
                </h2>
                <p>{project.summary}</p>
                {project.github && <a href={project.github}>GitHub</a>}
            </article>
        ))}
    </main>
</Layout>