---
import '@fontsource/caudex';
import '@fontsource/caudex/700.css';
import Menu from '../components/Menu.svelte';
const { title = "ThatOnePortfolio" } = Astro.props;
const isHome = Astro.url.pathname === "/";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<!isHome && Menu client:load />
		<slot />
	</body>
</html>

<style is:global>
  :root {
    --color-background: #22043a;
    --color-surface: #480d50;
    --color-line: #7b357f;
    --color-accent: #c574b1;
    --color-text: #f4d6e2;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    font-family: 'Caudex', serif;
    background: var(--color-background);
    color: var(--color-text);
  }

  button {
    font: inherit;
  }
</style>